{
  "name": "automarket",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "node server.js",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --exclude src/test/firestore-rules.test.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:firestore-rules": "firebase emulators:exec --only firestore \"vitest run src/test/firestore-rules.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.101.0",
    "cloudinary": "2.10.0",
    "clsx": "2.1.1",
    "concurrently": "10.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "firebase": "12.14.0",
    "firebase-admin": "14.2.0",
    "framer-motion": "12.40.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-is": "19.2.7",
    "react-router-dom": "7.16.0",
    "recharts": "3.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^3.0.0",
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "4.1.10",
    "autoprefixer": "10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "15.24.0",
    "globals": "^17.6.0",
    "jsdom": "29.1.1",
    "png-to-ico": "3.0.1",
    "postcss": "8.5.15",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "4.1.10"
  }
}
