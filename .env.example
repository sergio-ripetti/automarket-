# ============================================
# FRONTEND ENVIRONMENT VARIABLES (VITE_ prefix)
# ============================================

# Anthropic API key (for AI Assistant) - FRONTEND
# Get your key from: https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Backend origin for production (e.g. https://your-backend-host.example.com - no trailing
# slash, and WITHOUT an "/api" suffix; every request already includes "/api/..." in its path).
# REQUIRED in Vercel Production/Preview once the backend is deployed separately - without it,
# "/api/..." requests fall through to vercel.json's SPA rewrite and receive index.html instead
# of JSON. Leave empty for local development (Vite's dev-server proxy in vite.config.ts forwards
# "/api" to the local Express server on :3001).
VITE_API_BASE_URL=

# Public portfolio demo credentials shown in the Admin Login "Demo Access" modal - FRONTEND
# These are intentionally public (shown to recruiters/reviewers) and must always point at the
# restricted 'demo'-role account (see scripts/bootstrap-demo-user.js), NEVER the real
# administrator. Leave both empty to disable the modal's credential display safely - it falls
# back to "Demo access is temporarily unavailable" rather than showing anything real.
VITE_DEMO_ADMIN_EMAIL=demo.admin@automarket.co.nz
VITE_DEMO_ADMIN_PASSWORD=

# ============================================
# BACKEND ENVIRONMENT VARIABLES (no VITE_ prefix)
# ============================================

# Anthropic API key (for AI Assistant) - BACKEND
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Cloudinary Admin API credentials - BACKEND
# Required to delete Sales documents/photos from Cloudinary when removed in Edit Sale.
# Get these from: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=dlfgvbtzz
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Frontend URL for CORS validation - BACKEND
# For production, set this to your deployed frontend URL (no trailing slash required - CORS
# origin comparison normalizes one if present)
FRONTEND_URL=https://yourdomain.com

# Node runtime version - BACKEND (Render deployment only; see render.yaml)
# NODE_VERSION=22

# ============================================
# Firebase Admin SDK Configuration
# ============================================
# AI endpoint authentication uses Firebase ID tokens verified by Firebase Admin SDK
# Choose ONE of these options:

# Option 1: Disable Firebase Admin for local development
FIREBASE_ADMIN_SDK_DISABLED=true

# Option 2: Provide service account JSON as base64-encoded string
# Create in Firebase Console: Project Settings → Service Accounts → Generate New Private Key
# Encode as: base64 serviceaccount.json | tr -d '\n'
# FIREBASE_SERVICE_ACCOUNT=base64_encoded_json_here

# Option 3: Provide path to service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# ============================================
# Demo account bootstrap (scripts/bootstrap-demo-user.js only - not read by server.js)
# ============================================
# Optional: lets the bootstrap script run without CLI arguments. Never commit real values here.
# DEMO_USER_EMAIL=demo.admin@automarket.co.nz
# DEMO_USER_PASSWORD=

# ============================================
# DEPRECATED (Backend now uses Firebase tokens)
# ============================================
# Static API keys removed - use Firebase Authentication instead
# VITE_AI_ASSISTANT_API_KEY=no_longer_used
# AI_ASSISTANT_API_KEY=no_longer_used
